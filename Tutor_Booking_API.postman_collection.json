		{
			"name": "Availability (Tutor)",
			"item": [
				{
					"name": "Create Availability Slot",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Use tutor_token if available, otherwise fallback to access_token",
									"const tutorToken = pm.environment.get('tutor_token');",
									"if (tutorToken) {",
									"    pm.environment.set('access_token', tutorToken);",
									"    console.log('✅ Using tutor_token for authentication');",
									"} else {",
									"    console.log('⚠️ tutor_token not found, using access_token');",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set('availability_id', jsonData.data.id);",
									"    console.log('✅ Availability created with ID:', jsonData.data.id);",
									"} else if (pm.response.code === 401) {",
									"    console.error('❌ Unauthorized: Please login as tutor first');",
									"}"
								],
								"type": "text/javascript"
							}
